{
  "name": "@ydokimura/skills-registry-server",
  "version": "1.0.0",
  "description": "Private registry server for skills CLI",
  "license": "MIT",
  "main": "dist/src/index.js",
  "bin": {
    "skills-registry-server": "./dist/src/index.js"
